# ------------------------------------------------------------------
# Yoga with Anne - environment variables
# Copy to .env and fill in. Never commit real secrets.
# The app RUNS WITHOUT ANY of these set (development fallbacks kick in,
# payments route to a clearly-labelled test page and email to a preview log).
# ------------------------------------------------------------------

# --- Database ------------------------------------------------------
# SQLite file location. In production use a persistent disk/volume.
DATABASE_URL=file:./data/app.db

# --- Admin bootstrap (used by `npm run db:seed` if the admin table is empty)
ADMIN_EMAIL=anne@yogawithanne.ie
ADMIN_PASSWORD=change-me-immediately

# --- Payments: Stripe (test mode first) ----------------------------
# Without these, checkout uses the built-in test payment page (dev only).
# Create at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). See DEPLOYMENT.md for `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Public site origin, used to build Stripe success/cancel URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email: Resend (or leave empty to use the dev preview log) -----
# https://resend.com - verify your sending domain first.
RESEND_API_KEY=
EMAIL_FROM="Yoga with Anne <hello@yogawithanne.ie>"

# --- Scheduled jobs ------------------------------------------------
# Shared secret for /api/cron/reminders (class reminder emails).
CRON_TOKEN=dev-cron-token

# --- Behaviour toggles --------------------------------------------
# Set to 0 in production to disable the simulated "test payment" page.
DEV_PAYMENTS=1
# force-dynamic default; do not change unless you understand the caching impact.
